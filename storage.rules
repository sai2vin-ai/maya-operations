rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user has ACTIVE status in Firestore
    function isActiveUser() {
      return isAuthenticated() &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    // Validate image file
    function isValidImage(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Gate entries photos - only active users can upload
    match /gate-entries/{entryId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() && isValidImage(10);
    }

    // Batch photos - only active users can upload
    match /batches/{batchId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() && isValidImage(10);
    }

    // User profile photos - user can only upload to their own folder
    match /users/{userId}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId &&
                     isActiveUser() &&
                     isValidImage(5);
    }
  }
}
