rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    function isManager() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'PLANT_MANAGER'];
    }

    function isSupervisor() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'PLANT_MANAGER', 'SHIFT_SUPERVISOR'];
    }

    function isActiveUser() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId) || isManager();

      // Only admins can create/update users
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && onlyAllowedFields());
      allow delete: if isAdmin();

      function onlyAllowedFields() {
        // Regular users can only update certain fields
        let allowedFields = ['name', 'phone', 'profilePhoto', 'updatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
      }
    }

    // Devices collection
    match /devices/{deviceId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Gate Entries collection
    match /gateEntries/{entryId} {
      allow read: if isActiveUser();

      // Gate operators, supervisors, managers can create entries
      allow create: if isActiveUser() &&
                      getUserRole() in
                      ['SUPER_ADMIN', 'PLANT_MANAGER', 'SHIFT_SUPERVISOR', 'GATE_OPERATOR'];

      // Only supervisors+ can update/delete
      allow update, delete: if isSupervisor();
    }

    // Assets collection (includes reactors as category=REACTOR)
    match /assets/{assetId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
                              getUserRole() in
                              ['SUPER_ADMIN', 'PLANT_MANAGER', 'MAINTENANCE_TECH', 'REACTOR_OPERATOR'];
      allow delete: if isManager();
    }

    // Batches collection
    match /batches/{batchId} {
      allow read: if isActiveUser();

      // Reactor operators, supervisors, managers can create/update batches
      allow create, update: if isActiveUser() &&
                              getUserRole() in
                              ['SUPER_ADMIN', 'PLANT_MANAGER', 'SHIFT_SUPERVISOR', 'REACTOR_OPERATOR'];

      // Only managers can delete batches
      allow delete: if isManager();
    }

    // Audit Logs collection (read-only for users, written by functions)
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow write: if false; // Only Cloud Functions can write
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
                              getUserRole() in
                              ['SUPER_ADMIN', 'PLANT_MANAGER', 'STORES_KEEPER'];
      allow delete: if isAdmin();
    }

    // Spare Parts collection
    match /spareParts/{partId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
                              getUserRole() in
                              ['SUPER_ADMIN', 'PLANT_MANAGER', 'STORES_KEEPER'];
      allow delete: if isAdmin();
    }

    // Spare Part Transactions collection
    match /sparePartTransactions/{txId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() &&
                      getUserRole() in
                      ['SUPER_ADMIN', 'PLANT_MANAGER', 'STORES_KEEPER', 'MAINTENANCE_TECH'];
      allow update, delete: if isAdmin();
    }

    // Maintenance Jobs collection
    match /maintenanceJobs/{jobId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
                              getUserRole() in
                              ['SUPER_ADMIN', 'PLANT_MANAGER', 'MAINTENANCE_TECH'];
      allow delete: if isManager();
    }

    // Quality Checks collection
    match /qualityChecks/{checkId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
                              getUserRole() in
                              ['SUPER_ADMIN', 'PLANT_MANAGER', 'SHIFT_SUPERVISOR', 'REACTOR_OPERATOR'];
      allow delete: if isManager();
    }

    // Weighbridge Entries collection
    match /weighbridgeEntries/{entryId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser() &&
                              getUserRole() in
                              ['SUPER_ADMIN', 'PLANT_MANAGER', 'WEIGHBRIDGE_OPERATOR', 'GATE_OPERATOR'];
      allow delete: if isManager();
    }

    // Inventory Transactions collection
    match /inventoryTransactions/{txId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() &&
                      getUserRole() in
                      ['SUPER_ADMIN', 'PLANT_MANAGER', 'STORES_KEEPER'];
      allow update, delete: if isAdmin();
    }

    // Shifts collection
    match /shifts/{shiftId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isSupervisor();
    }

    // Webhooks collection
    match /webhooks/{webhookId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Webhook Deliveries collection
    match /webhookDeliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Bug Reports collection
    match /bugReports/{reportId} {
      // All active users can create bug reports
      allow create: if isActiveUser();
      // Only managers can read/manage bug reports
      allow read: if isManager() || (isActiveUser() && resource.data.createdBy.userId == request.auth.uid);
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Role Permissions collection (dynamic permissions config)
    match /rolePermissions/{roleId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Notifications collection (written by Cloud Functions only)
    match /notifications/{notificationId} {
      allow read: if isActiveUser();
      allow write: if false; // Only Cloud Functions can write

      // Per-user read status subcollection
      match /readBy/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }
  }
}
